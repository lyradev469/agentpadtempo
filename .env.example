# AgentPad Frontend Environment Variables
# Copy this to .env.local for local development

# Tempo RPC URL
NEXT_PUBLIC_RPC_URL=https://rpc.moderato.tempo.xyz

# WalletConnect Project ID (REQUIRED for WalletConnect to work)
# Get one from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=85be66e6169307dc900bc2337d69d10a

# Remote Key Manager Backend URL (optional)
# NEXT_PUBLIC_KEY_MANAGER_URL=https://your-backend.com

# Remote Key Manager API Key (optional)
# NEXT_PUBLIC_KEY_MANAGER_API_KEY=your-api-key

# Node Environment
NODE_ENV=development
